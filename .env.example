# ---------------------------------------------------------------------------
# BioTrace AI configuration. Copy to .env and adjust.
# ---------------------------------------------------------------------------

# --- FalkorDB (mandatory core database) -----------------------------------
# Local Docker:      docker compose up -d
# FalkorDB Cloud:    point at the tls:// endpoint your instance gives you
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_TLS=false
FALKORDB_GRAPH=biotrace_knowledge_graph

# --- Agent LLM ------------------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint works (OpenAI, Azure,
# OpenRouter, Groq, Together, vLLM, Ollama, LM Studio) plus Anthropic's
# native Messages API via LLM_PROVIDER=anthropic.
#
# If no key is configured the agent automatically falls back to the
# deterministic planner (AgentMode=deterministic), which runs the exact same
# FalkorDB tools in a fixed, domain-grounded order. The demo is fully
# functional without any API key.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TEMPERATURE=0
LLM_MAX_TOOL_ROUNDS=8

# --- API ------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Comma separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3010,http://127.0.0.1:3010

# --- Frontend -------------------------------------------------------------
# Baked into the Next.js app at build time.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
